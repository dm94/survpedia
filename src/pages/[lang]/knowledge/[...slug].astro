---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import Entry from '@layouts/Entry.astro';
import { useTranslations } from '@i18n/utils';

export async function getStaticPaths() {
  const knowledge = await getCollection('knowledge');
  return knowledge.map(entry => {
    const [lang, slug] = entry.id.split('/');
    return {
      params: { lang, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { lang } = Astro.params;
const t = useTranslations(lang as any);

const getDescriptionFromMarkdown = (markdown: string) => {
  const cleaned = markdown
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned.slice(0, 160);
};
const rawDescription = getDescriptionFromMarkdown(entry.body ?? '');
const metaDescription =
  rawDescription.length > 0 ? rawDescription : entry.data.title;
const metaImage = entry.data.image?.src ?? '/logo.png';

const materialLinks: {
  id: string;
  href: string;
  name: string;
  exists: boolean;
}[] = await Promise.all(
  (entry.data.relatedMaterials ?? []).map(async (id: string) => {
    const material = await getEntry('materials', `${lang}/${id}`);
    return {
      id,
      href: `/${lang}/materials/${id}`,
      name: material?.data.title ?? id,
      exists: Boolean(material),
    };
  })
);
---

<Layout
  title={entry.data.title}
  description={metaDescription}
  image={metaImage}
>
  <Entry
    title={entry.data.title}
    lang={lang}
    backHref={`/${lang}/knowledge`}
    backLabel={t('knowledge.title')}
    body={entry.body ?? ''}
    aiGenerated={entry.data.aiGenerated}
  >
    <Fragment slot="lead">
      {
        entry.data.image && (
          <div class="mt-8 border border-rule">
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              class="h-64 w-full object-cover"
            />
          </div>
        )
      }
    </Fragment>

    <Content />

    <Fragment slot="rail">
      {
        materialLinks.length > 0 && (
          <section>
            <h2 class="meta-label">{t('common.relatedMaterials')}</h2>
            <ul class="mt-3 border-t border-rule">
              {materialLinks.map(link => (
                <li class="border-b border-rule">
                  {link.exists ? (
                    <a
                      href={link.href}
                      class="block py-2 text-sm text-ink/85 transition-colors hover:text-accent"
                    >
                      {link.name}
                    </a>
                  ) : (
                    <span class="block py-2 text-sm text-ink-muted">
                      {link.name}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </Fragment>
  </Entry>
</Layout>
