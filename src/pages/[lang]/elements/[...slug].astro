---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import Entry from '@layouts/Entry.astro';
import { useTranslations } from '@i18n/utils';

export async function getStaticPaths() {
  const elements = await getCollection('elements');
  return elements.map(entry => {
    const [lang, slug] = entry.id.split('/');
    return {
      params: { lang, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as any);

const getDescriptionFromMarkdown = (markdown: string) => {
  const cleaned = markdown
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned.slice(0, 160);
};
const { Content } = await render(entry);
const rawDescription = getDescriptionFromMarkdown(entry.body ?? '');
const metaDescription =
  rawDescription.length > 0 ? rawDescription : entry.data.title;
const metaImage = entry.data.image?.src ?? '/logo.png';
---

<Layout
  title={entry.data.title}
  description={metaDescription}
  image={metaImage}
>
  <Entry
    title={entry.data.title}
    lang={lang}
    backHref={`/${lang}/elements`}
    backLabel={t('elements.title')}
    body={entry.body ?? ''}
    aiGenerated={entry.data.aiGenerated}
  >
    <Fragment slot="meta">
      <span class="font-data text-[11px] uppercase leading-none tracking-[0.14em] text-ink-muted">
        {entry.data.category}
      </span>
    </Fragment>

    <Fragment slot="lead">
      <dl class="mt-8 grid grid-cols-2 gap-px border border-rule bg-rule sm:max-w-md">
        <div class="bg-paper px-4 py-3">
          <dt class="meta-label">{t('elements.symbol')}</dt>
          <dd class="mt-2 font-read text-2xl leading-none">{entry.data.symbol}</dd>
        </div>
        <div class="bg-paper px-4 py-3">
          <dt class="meta-label">{t('elements.atomicMass')}</dt>
          <dd class="mt-2 font-data text-lg leading-none tabular-nums">
            {entry.data.atomicMass}
          </dd>
        </div>
      </dl>

      {
        entry.data.image && (
          <div class="mt-6 border border-rule">
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              class="h-64 w-full object-cover"
            />
          </div>
        )
      }
    </Fragment>

    <Content />

    <Fragment slot="rail">
      <section>
        <h2 class="meta-label">{t('elements.extraction')}</h2>
        {
          entry.data.extractionProcess ? (
            <p class="mt-3 text-sm leading-relaxed text-ink/85">
              {entry.data.extractionProcess}
            </p>
          ) : (
            <p class="mt-3 font-data text-xs text-ink-muted">—</p>
          )
        }
      </section>
    </Fragment>
  </Entry>
</Layout>
