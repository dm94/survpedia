---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import Entry from '@layouts/Entry.astro';
import { useTranslations } from '@i18n/utils';

export async function getStaticPaths() {
  const materials = await getCollection('materials');
  return materials.map(entry => {
    const [lang, slug] = entry.id.split('/');
    return {
      params: { lang, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { lang } = Astro.params;
const t = useTranslations(lang as any);

const getDescriptionFromMarkdown = (markdown: string) => {
  const cleaned = markdown
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned.slice(0, 160);
};
const rawDescription = getDescriptionFromMarkdown(entry.body ?? '');
const metaDescription =
  rawDescription.length > 0 ? rawDescription : entry.data.title;
const metaImage = entry.data.image?.src ?? '/logo.png';

const compositionLinks: {
  id: string;
  href: string;
  name: string;
  exists: boolean;
}[] = await Promise.all(
  (entry.data.composition ?? []).map(async (id: string) => {
    const element = await getEntry('elements', `${lang}/${id}`);
    return {
      id,
      href: `/${lang}/elements/${id}`,
      name: element?.data.title ?? id,
      exists: Boolean(element),
    };
  })
);
---

<Layout
  title={entry.data.title}
  description={metaDescription}
  image={metaImage}
>
  <Entry
    title={entry.data.title}
    lang={lang}
    backHref={`/${lang}/materials`}
    backLabel={t('materials.title')}
    body={entry.body ?? ''}
    aiGenerated={entry.data.aiGenerated}
  >
    <Fragment slot="meta">
      <span class="font-data text-[11px] uppercase leading-none tracking-[0.14em] text-ink-muted">
        {entry.data.naturalAvailability
          ? t('materials.natural')
          : t('materials.synthetic')}
      </span>
    </Fragment>

    <Fragment slot="lead">
      {
        entry.data.formula && (
          <p class="mt-7 font-data text-2xl leading-none tracking-[-0.01em] text-ink/80">
            {entry.data.formula}
          </p>
        )
      }

      {
        entry.data.image && (
          <div class="mt-7 border border-rule">
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              class="h-64 w-full object-cover"
            />
          </div>
        )
      }
    </Fragment>

    <Content />

    <Fragment slot="rail">
      {
        compositionLinks.length > 0 && (
          <section>
            <h2 class="meta-label">{t('common.madeOf')}</h2>
            <ul class="mt-3 border-t border-rule">
              {compositionLinks.map(link => (
                <li class="border-b border-rule">
                  {link.exists ? (
                    <a
                      href={link.href}
                      class="block py-2 text-sm text-ink/85 transition-colors hover:text-accent"
                    >
                      {link.name}
                    </a>
                  ) : (
                    <span class="block py-2 text-sm text-ink-muted">
                      {link.name}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="mt-8 border-t border-rule pt-6">
        <h2 class="meta-label">{t('common.properties')}</h2>
        <ul class="mt-3 space-y-1.5">
          {
            entry.data.properties.map((property: string) => (
              <li class="text-sm leading-relaxed text-ink/85">{property}</li>
            ))
          }
        </ul>
      </section>

      <section class="mt-8 border-t border-rule pt-6">
        <h2 class="meta-label">{t('common.usedFor')}</h2>
        <ul class="mt-3 space-y-1.5">
          {
            entry.data.uses.map((use: string) => (
              <li class="text-sm leading-relaxed text-ink/85">{use}</li>
            ))
          }
        </ul>
      </section>

      {
        entry.data.manufacturingProcess && (
          <section class="mt-8 border-t border-rule pt-6">
            <h2 class="meta-label">{t('materials.manufacturing')}</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink/85">
              {entry.data.manufacturingProcess}
            </p>
          </section>
        )
      }
    </Fragment>
  </Entry>
</Layout>
