---
import Layout from '@layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  t('contribute.step1'),
  t('contribute.step2'),
  t('contribute.step3'),
  t('contribute.step4'),
];
---

<Layout title={t('404.title')} description={t('404.description')} noindex={true}>
  <div class="mx-auto max-w-[46rem] py-8">
    <h1
      class="font-read text-[clamp(4rem,14vw,8rem)] font-normal leading-[0.82] tracking-[-0.04em] text-ink"
    >
      404
    </h1>

    <p class="mt-6 max-w-[42ch] text-lg leading-relaxed text-ink-muted">
      {t('404.description')}
    </p>

    <section class="mt-14 border-t border-rule pt-8">
      <h2 class="font-read text-2xl font-semibold tracking-[-0.01em]">
        {t('404.contribute.title')}
      </h2>
      <p class="mt-3 max-w-[52ch] leading-relaxed text-ink/85">
        {t('404.contribute.description')}
      </p>

      <ol class="mt-8 border-y border-rule">
        {
          steps.map((step, index) => (
            <li class="flex items-baseline gap-5 border-b border-rule py-3.5 last:border-b-0">
              <span class="w-6 shrink-0 font-data text-[11px] tabular-nums text-accent">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-ink/85">{step}</span>
            </li>
          ))
        }
      </ol>

      <p class="mt-4 font-data text-[11px] uppercase leading-relaxed tracking-[0.12em] text-ink-muted">
        {t('contribute.footer')}
      </p>
    </section>

    <a
      href={`/${lang}`}
      class="mt-10 inline-flex items-center gap-2 border border-rule px-4 py-2 text-sm transition-colors duration-150 hover:border-accent hover:text-accent"
    >
      {t('nav.home')}
    </a>
  </div>
</Layout>
