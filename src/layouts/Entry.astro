---
import BackLink from '@components/BackLink.astro';
import ReadingTime from '@components/ReadingTime.astro';
import { useTranslations } from '@i18n/utils';

interface Props {
  title: string;
  lang: any;
  backHref: string;
  backLabel: string;
  body: string;
  aiGenerated?: boolean;
}

const { title, lang, backHref, backLabel, body, aiGenerated } = Astro.props;
const t = useTranslations(lang);
---

<div class="mx-auto max-w-[1100px]">
  <BackLink href={backHref} label={backLabel} />

  <article class="mt-6">
    <header class="border-t-2 border-ink pt-6">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          aiGenerated && (
            <span class="tag border-accent/40 text-accent">
              {t('common.aiGenerated')}
            </span>
          )
        }
        <slot name="meta" />
        <ReadingTime body={body} lang={lang} />
      </div>

      <h1
        class="mt-5 max-w-[24ch] font-read text-[clamp(2.1rem,5.2vw,3.4rem)] font-normal leading-[1.02] tracking-[-0.025em] text-ink"
      >
        {title}
      </h1>

      <slot name="lead" />
    </header>

    <div
      class="mt-8 grid gap-10 border-t border-rule pt-8 lg:grid-cols-[minmax(0,1fr)_248px] lg:gap-14"
    >
      <div class="entry-body">
        <slot />
      </div>

      <aside class="border-t border-rule pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <slot name="rail" />
      </aside>
    </div>
  </article>
</div>
