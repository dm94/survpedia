---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  body?: string;
  href: string;
  tag?: string;
  image?: ImageMetadata;
}

const { href, title, body, tag, image } = Astro.props;
---

<li class="border-b border-rule">
	<a
		href={href}
		class="entry-row items-center gap-4 px-1 group"
	>
		{image && (
			<span class="hidden h-12 w-12 shrink-0 overflow-hidden border border-rule sm:block">
				<Image
					src={image}
					alt=""
					width={96}
					height={96}
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</span>
		)}

		<span class="min-w-0 flex-1">
			<span class="block font-read text-[1.0625rem] leading-snug transition-colors duration-150 group-hover:text-accent">
				{title}
			</span>
			{body && (
				<span class="mt-1 block truncate font-data text-[11px] leading-none text-ink-muted">
					{body}
				</span>
			)}
		</span>

		{tag && <span class="tag hidden shrink-0 sm:inline-flex">{tag}</span>}

		<svg
			xmlns="http://www.w3.org/2000/svg"
			class="h-3.5 w-3.5 shrink-0 text-rule-strong transition-colors duration-150 group-hover:text-accent"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="1.5"
			aria-hidden="true"
		>
			<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
		</svg>
	</a>
</li>
