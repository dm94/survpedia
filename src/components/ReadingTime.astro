---
import { useTranslations } from '@i18n/utils';

interface Props {
  body: string;
  lang: any;
}

const { body, lang } = Astro.props;
const t = useTranslations(lang);

const wordCount = body ? body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<span class="whitespace-nowrap font-data text-[11px] uppercase leading-none tracking-[0.14em] text-ink-muted">
  {t('common.readingTime').replace('{minutes}', readingTime.toString())}
</span>
