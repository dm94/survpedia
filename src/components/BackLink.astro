---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-2 font-data text-[11px] uppercase leading-none tracking-[0.14em] text-ink-muted transition-colors hover:text-accent"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-3.5 w-3.5 transition-transform duration-200 ease-manual group-hover:-translate-x-1"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
  </svg>
  <span>{label}</span>
</a>
