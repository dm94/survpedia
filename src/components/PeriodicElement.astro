---
import { getCategoryKey } from '@/lib/element-category';

interface Props {
	symbol: string;
	number: number;
	name: string;
	category: string;
	href: string;
}

const { symbol, number, name, category, href } = Astro.props;
const categoryKey = getCategoryKey(category);
---

<a
	href={href}
	data-cat={categoryKey}
	class="el-tile"
	aria-label={`${number} ${name} (${symbol}) — ${category}`}
	title={`${number} ${name} (${symbol}) — ${category}`}
>
	<span class="el-tile__number" aria-hidden="true">{number}</span>
	<span class="el-tile__symbol" aria-hidden="true">{symbol}</span>
	<span class="el-tile__name" aria-hidden="true">{name}</span>
</a>
