---
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const searchPlaceholder = t('search.placeholder');
const searchNoResults = t('search.noResults');
---

<div id="search-container" class="relative">
  <button
    id="search-trigger"
    type="button"
    aria-label={t('nav.search')}
    aria-haspopup="true"
    aria-expanded="false"
    class="flex h-8 items-center gap-2 border border-rule px-2 text-ink-muted transition-colors duration-150 hover:border-accent hover:text-accent"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-3.5 w-3.5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <span class="hidden font-data text-[11px] uppercase leading-none tracking-[0.12em] sm:inline">
      {t('nav.search')}
    </span>
    <kbd
      class="hidden border border-rule px-1.5 py-0.5 font-data text-[11px] leading-none text-ink-muted md:inline"
    >
      /
    </kbd>
  </button>

  <div
    id="pagefind-ui"
    class="absolute right-0 top-10 z-[100] hidden max-h-[78vh] w-[calc(100vw-2.5rem)] max-w-[460px] overflow-y-auto border border-rule bg-paper p-2"
  >
  </div>
</div>

<div
  id="search-backdrop"
  class="fixed inset-0 z-[90] hidden bg-ink/25"
  aria-hidden="true"
>
</div>

<!-- Pagefind assets are written to /pagefind/ by the build step. -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<script define:vars={{ searchPlaceholder, searchNoResults }}>
  const container = document.getElementById("pagefind-ui");
  const trigger = document.getElementById("search-trigger");
  const backdrop = document.getElementById("search-backdrop");
  let initialized = false;

  const initSearch = () => {
    if (initialized) return;
    // @ts-ignore
    if (typeof PagefindUI !== "undefined") {
      // @ts-ignore
      new PagefindUI({
        element: "#pagefind-ui",
        showSubResults: true,
        resetStyles: false,
        translations: {
          placeholder: searchPlaceholder,
          zero_results: searchNoResults,
        },
      });
      initialized = true;
    } else {
      container.innerHTML =
        '<p class="border border-rule p-3 font-data text-[11px] text-ink-muted">Search is available in a production build.</p>';
    }
  };

  const toggleSearch = (forceClose = false) => {
    const isHidden = forceClose ? true : !container?.classList.contains("hidden");

    if (isHidden) {
      container?.classList.add("hidden");
      backdrop?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
      trigger?.setAttribute("aria-expanded", "false");
    } else {
      container?.classList.remove("hidden");
      backdrop?.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
      trigger?.setAttribute("aria-expanded", "true");
      initSearch();
      setTimeout(() => {
        const input = container?.querySelector("input");
        if (input) input.focus();
      }, 100);
    }
  };

  trigger?.addEventListener("click", () => toggleSearch());
  backdrop?.addEventListener("click", () => toggleSearch(true));

  document.addEventListener("keydown", (e) => {
    const target = e.target;
    if (e.key === "/" && target instanceof HTMLElement && !["INPUT", "TEXTAREA"].includes(target.tagName)) {
      e.preventDefault();
      if (container?.classList.contains("hidden")) {
        toggleSearch();
      }
    }
    if (e.key === "Escape" && !container?.classList.contains("hidden")) {
      toggleSearch(true);
      if (trigger instanceof HTMLElement) trigger.focus();
    }
  });

  document.addEventListener("click", e => {
    const target = e.target;
    const isInside = (target instanceof Node) && (container?.contains(target) || trigger?.contains(target));
    const isDetached = !document.documentElement.contains(target);

    if (!isInside && !isDetached && !container?.classList.contains("hidden")) {
      toggleSearch(true);
    }
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-primary: rgb(var(--accent));
    --pagefind-ui-text: rgb(var(--ink));
    --pagefind-ui-background: rgb(var(--paper));
    --pagefind-ui-border: rgb(var(--rule));
    --pagefind-ui-tag: rgb(var(--paper-sunken));
    --pagefind-ui-font: var(--font-read);
    --pagefind-ui-border-radius: 0;
  }

  .pagefind-ui__search-input {
    @apply border border-rule bg-paper-sunken px-2 py-2 font-read text-sm text-ink !important;
  }

  .pagefind-ui__search-input:focus {
    @apply border-accent outline-none !important;
    box-shadow: inset 0 0 0 1px rgb(var(--accent)) !important;
  }

  .pagefind-ui__search-clear {
    @apply bg-paper-sunken font-data text-[11px] uppercase tracking-[0.1em] !important;
  }

  .pagefind-ui__drawer {
    @apply gap-3 !important;
  }

  .pagefind-ui__result {
    @apply border-b border-rule px-1 !important;
  }

  .pagefind-ui__result-thumb {
    @apply hidden !important;
  }

  .pagefind-ui__result-link {
    @apply font-read text-[0.95rem] text-ink transition-colors hover:text-accent !important;
  }

  .pagefind-ui__result-excerpt {
    @apply font-read text-xs leading-relaxed text-ink-muted !important;
  }

  .pagefind-ui__result-excerpt mark {
    @apply bg-transparent font-semibold text-accent !important;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pagefind-ui__message {
    @apply px-1 py-2 font-data text-[11px] uppercase tracking-[0.12em] text-ink-muted !important;
  }

  .pagefind-ui__button {
    @apply border border-rule bg-transparent font-data text-[11px] uppercase tracking-[0.12em] text-ink-muted transition-colors hover:border-accent hover:text-accent !important;
  }

  #pagefind-ui::-webkit-scrollbar {
    width: 6px;
  }

  #pagefind-ui::-webkit-scrollbar-thumb {
    background: rgb(var(--rule-strong));
    border: 0;
  }
</style>
