---
import { useTranslations } from '@i18n/utils';

interface Props {
  count: number;
  lang: any;
  collection: 'elements' | 'materials' | 'inventions' | 'knowledge';
}

const { count, lang, collection } = Astro.props;
const t = useTranslations(lang);

const suffix = count === 1 ? 'one' : 'other';
const label = t(`${collection}.count.${suffix}` as any).replace(
  '{count}',
  count.toString()
);
---

<span class="whitespace-nowrap font-data text-[11px] uppercase leading-none tracking-[0.14em] tabular-nums text-ink-muted">
  {label}
</span>
