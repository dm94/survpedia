---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getLocalizedPathname } from '@i18n/localized-path';
import { languages } from '@i18n/ui';
import Search from './Search.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homePath = `/${lang}`;
const navItems = [
  { key: 'elements', href: `/${lang}/elements` },
  { key: 'materials', href: `/${lang}/materials` },
  { key: 'inventions', href: `/${lang}/inventions` },
  { key: 'knowledge', href: `/${lang}/knowledge` },
] as const;

const currentPath = Astro.url.pathname;
const languageLinks = await Promise.all(
  Object.entries(languages).map(async ([code, label]) => ({
    code,
    label,
    href: await getLocalizedPathname(code, currentPath),
  }))
);
const isPathActive = (path: string) => currentPath.startsWith(path);
---

<header
  data-print-hide
  class="sticky top-0 z-50 border-b border-rule bg-paper"
>
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3 sm:px-8"
  >
    <a
      href={homePath}
      class="flex items-baseline gap-2.5 outline-none"
      aria-label="Survpedia"
    >
      <span class="font-read text-xl font-semibold tracking-[-0.01em]">Survpedia</span>
      <span
        class="hidden font-data text-[11px] uppercase leading-none tracking-[0.14em] text-ink-muted xl:inline"
      >
        {t('site.descriptor')}
      </span>
    </a>

    <nav class="order-3 w-full md:order-none md:w-auto">
      <ul
        class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:flex sm:flex-wrap sm:items-center sm:gap-x-5 sm:text-[15px]"
      >
        {
          navItems.map(({ key, href }) => (
            <li>
              <a
                href={href}
                aria-current={isPathActive(href) ? 'page' : undefined}
                class:list={[
                  'relative block py-1 transition-colors duration-150',
                  isPathActive(href)
                    ? 'text-accent after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:bg-accent'
                    : 'text-ink/75 hover:text-ink',
                ]}
              >
                {t(`nav.${key}` as any)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <Search />

      <div class="flex items-center border border-rule">
        {
          languageLinks.map(({ code, label, href }) => (
            <a
              href={href}
              aria-label={label}
              title={label}
              aria-current={code === lang ? 'true' : undefined}
              class:list={[
                'px-2 py-1.5 font-data text-[11px] uppercase leading-none tracking-[0.1em] transition-colors',
                code === lang
                  ? 'bg-ink text-paper'
                  : 'text-ink-muted hover:text-accent',
              ]}
            >
              {code}
            </a>
          ))
        }
      </div>

      <button
        id="theme-toggle"
        type="button"
        class="flex h-8 w-8 items-center justify-center border border-rule text-ink-muted transition-colors hover:border-accent hover:text-accent"
        aria-label={t('nav.themeToggle')}
      >
        <svg
          id="sun-icon"
          class="hidden h-[15px] w-[15px] dark:block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2m0 14v2m9-9h-2M3 12h2m15.364-6.364l-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0l-1.414-1.414M7.05 7.05L5.636 5.636M12 8a4 4 0 100 8 4 4 0 000-8z"
          ></path>
        </svg>
        <svg
          id="moon-icon"
          class="block h-[15px] w-[15px] dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const element = document.documentElement;
    element.classList.toggle('dark');

    const isDark = element.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
